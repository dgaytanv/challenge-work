    out = args.out or os.path.join(args.runs_dir, "table.md")
    with open(out, "w") as f:
        f.write(doc)
    print(doc)
    print(f"[ablation] wrote {out}")

    if args.plot:
        wanted = None if args.plot == "all" else set(args.plot.split(","))
        for r in runs:
            if wanted is None or r["tag"] in wanted:
                print(f"[ablation] wrote {plot_curves(r, args.runs_dir)}")


